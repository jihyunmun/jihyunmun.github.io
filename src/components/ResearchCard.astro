---
import type { CollectionEntry } from 'astro:content';
import ResearchMedia from './ResearchMedia.astro';

interface Props {
  entry: CollectionEntry<'research'>;
  featured?: boolean;
}
const { entry, featured = false } = Astro.props;
const { title, dek, media } = entry.data;
const href = `/research/${entry.id}/`;
---
<article class:list={['card', featured && 'featured']}>
  <a class="frame" href={href} tabindex="-1" aria-hidden="true">
    <ResearchMedia
      media={media}
      ratio={featured ? '16 / 7' : '5 / 3'}
      loading={featured ? 'eager' : 'lazy'}
      trueRatio={featured}
    />
  </a>
  <div class="caption">
    <h3><a href={href}>{title}</a></h3>
    <p class="dek">{dek}</p>
  </div>
</article>

<style>
  .card { display: block; }
  .frame { display: block; text-decoration: none; }
  h3 {
    font-family: var(--serif);
    font-size: 20px;
    line-height: 1.25;
    margin-top: 15px;
  }
  .featured h3 { font-size: 25px; letter-spacing: -.01em; }
  h3 a { text-decoration: none; }
  h3 a:hover { color: var(--accent); }
  /* Inside a grid card the column already sets the measure, so text fills it.
     The featured card is full width, so it takes the site measure instead —
     title and text then end on the same edge. */
  .dek { color: var(--soft); font-size: 14.5px; margin: 9px 0 0; }

  /* A grid card is already a narrow column, so its caption stacks. The
     featured card is as wide as the hero media, and a half-width caption
     under a full-width figure reads as unfinished — so there the title and
     the summary sit side by side and together fill the same edge. */
  .featured .caption {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 0 40px; align-items: start; margin-top: 18px;
  }
  .featured h3 { margin-top: 0; }
  .featured .dek { font-size: 15.5px; margin-top: 4px; }
  @media (max-width: 760px) {
    .featured .caption { grid-template-columns: 1fr; gap: 0; }
    .featured .dek { margin-top: 9px; }
  }
</style>
