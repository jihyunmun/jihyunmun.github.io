---
import Base from '../layouts/Base.astro';
import ResearchCard from '../components/ResearchCard.astro';
import NewsList from '../components/NewsList.astro';
import { getCollection } from 'astro:content';

const entries = (await getCollection('research', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);
const [featured, ...rest] = entries;

const links = [
  { label: 'GitHub', href: 'https://github.com/jihyunmun' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/jihyun-mun-b65a58142/' },
  { label: 'CV (PDF)', href: '/assets/pdfs/cv.pdf' },
  { label: 'Email', href: 'mailto:jihyun.mun@telecom-sudparis.eu' },
];
---
<Base title="Jihyun Mun">
  <header class="hero">
    <div>
      <h1>Making technology reach the people it keeps missing.</h1>
      <p class="role">Postdoctoral Researcher · Samovar, Télécom SudParis, Institut Polytechnique de Paris</p>
      <p class="bio">
        People living with a disorder, disease or disability are the ones technology serves
        last: the recogniser does not understand them, the screening test never reaches them,
        and the model that scores them cannot say why. I use AI to close that gap —
        across <em>signals</em>, the models that read them, and the explainability and
        evaluation that decide whether a result can be trusted.
      </p>
      <p class="bio">
        Explainability carries the weight. A score a clinician cannot interrogate is not a
        tool, however accurate.
      </p>
      <p class="links">
        {links.map((l) => <a href={l.href}>{l.label}</a>)}
      </p>
    </div>
    <NewsList limit={4} />
  </header>

  <p class="eyebrow sec">Selected research</p>
  <div class="feature"><ResearchCard entry={featured} featured /></div>
  <div class="grid">
    {rest.map((entry) => <ResearchCard entry={entry} />)}
  </div>
</Base>

<style>
  .hero {
    padding-block: 84px 52px;
    display: grid; gap: 28px;
    grid-template-columns: minmax(0, 1fr) 330px;
    align-items: start;
  }
  @media (max-width: 760px) {
    .hero { grid-template-columns: 1fr; padding-block: 52px 36px; }
  }
  /* One measure for every line of text in the hero, so the title and the
     paragraphs end on the same edge instead of three different ones. */
  h1 {
    font-size: clamp(34px, 5vw, 50px); line-height: 1.06; letter-spacing: -.02em;
    max-width: var(--measure);
  }
  /* Descriptive text, so it takes the body face. Mono is reserved for things
     you navigate by: links, labels, dates, identifiers. */
  .role {
    font-size: 15px; color: var(--accent); margin: 18px 0 0;
    max-width: var(--measure);
  }
  .bio { max-width: var(--measure); color: var(--soft); margin: 16px 0 0; font-size: 16.5px; }
  .bio em { color: var(--ink); font-style: normal; }
  .links {
    display: flex; flex-wrap: wrap; gap: 8px 14px; margin: 26px 0 0;
    font-family: var(--mono); font-size: 12.5px;
  }
  .links a {
    text-decoration: none; color: var(--soft);
    border-bottom: 1px solid var(--rule); padding-bottom: 2px;
  }
  .links a:hover { color: var(--accent); border-bottom-color: var(--accent); }
  .sec { border-top: 1px solid var(--rule); padding-top: 12px; margin: 0 0 30px; }
  .feature { margin-bottom: 76px; }
  .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 56px 40px; }
  @media (max-width: 760px) { .grid { grid-template-columns: 1fr; gap: 44px; } }
</style>
